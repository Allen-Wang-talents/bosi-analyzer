{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/jobs.ts": {
      "includeFiles": ["server/**/*.ts", "shared/**/*.ts"]
    },
    "api/rank.ts": {
      "includeFiles": ["shared/**/*.ts"]
    },
    "api/diag.ts": {
      "includeFiles": ["server/**/*.ts", "shared/**/*.ts"]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
