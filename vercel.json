{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": {
      "includeFiles": "{server,shared}/**/*.ts"
    },
    "api/jobs.ts": {
      "includeFiles": "{server,shared}/**/*.ts"
    },
    "api/rank.ts": {
      "includeFiles": "{server,shared}/**/*.ts"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
