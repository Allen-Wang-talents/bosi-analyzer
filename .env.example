# =====================================================
# 环境变量模板 —— 复制成 .env 再填 (本地开发用)
#
#   cp .env.example .env
#
# .env 已被 gitignore, 里面的凭证不会进仓库。
# 线上 (Vercel / Netlify) 的同名变量在各自后台配, 不走这个文件。
# =====================================================

# --- MiniMax (AI 解析 / 对话 / 精排) ---
# 没有它, 本地开发时 AI 功能会一直报「服务端未配置 MINIMAX_API_KEY」
MINIMAX_API_KEY=

# --- 飞书应用凭证 (读岗位池) ---
# 需要应用开通 bitable:app:readonly, 并被加为「北京AI岗位汇总」的只读协作者
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- 飞书用户令牌 (可选) ---
# 两个都是 8.5KB 左右的 JWT, 超过 Netlify 环境变量 5000 字符上限,
# 所以线上是存在 Blobs 里 (bosi-secrets / feishu-user-token), 只有本地调试才填
FEISHU_USER_ACCESS_TOKEN=
FEISHU_USER_REFRESH_TOKEN=

# --- Netlify Blobs (账号库 + 飞书令牌) ---
# 只在本地调试 /api/auth 用得到
NETLIFY_BLOBS_TOKEN=
SITE_ID=
# 账号数据所在的 store, 默认 bosi-users
AUTH_BLOB_STORE=bosi-users

# --- 镜像站地址 ---
# Vercel 侧没配飞书凭证时, /api/jobs 和 /api/auth 会向镜像站借数据
JOBS_MIRROR_URL=https://bosi-analyzer.netlify.app
